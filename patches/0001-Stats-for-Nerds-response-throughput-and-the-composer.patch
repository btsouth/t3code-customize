diff --git a/apps/server/src/orchestration-v2/Adapters/CodexResponseThroughput.test.ts b/apps/server/src/orchestration-v2/Adapters/CodexResponseThroughput.test.ts
new file mode 100644
index 000000000..9e6d8b284
--- /dev/null
+++ b/apps/server/src/orchestration-v2/Adapters/CodexResponseThroughput.test.ts
@@ -0,0 +1,203 @@
+import type { TurnTokenUsage } from "@t3tools/contracts";
+import { describe, expect, it } from "@effect/vitest";
+
+import { CodexResponseThroughput } from "./CodexResponseThroughput.ts";
+
+const usage: TurnTokenUsage = {
+  usageStatus: "complete",
+  usageScope: "main_agent",
+  hasSubagents: false,
+  inputTokens: 100,
+  outputTokens: 400,
+  reasoningTokens: 100,
+};
+const origin = 1_800_000_000_000;
+const reasoning = { type: "reasoning", id: "reasoning" } as const;
+const text = { type: "agentMessage", id: "text", text: "Answer" } as const;
+const plan = { type: "plan", id: "plan", text: "Plan" } as const;
+const tool = { type: "sleep", id: "tool", durationMs: 100_000 } as const;
+const tracker = () => new CodexResponseThroughput(origin, 0);
+const expected = (elapsedMs: number, responseCount = 1, partial = false) => ({
+  basis: "codex_active_windows_estimate",
+  outputTokens: 400,
+  elapsedMs,
+  responseCount,
+  partial,
+});
+
+describe("stock Codex response activity estimate", () => {
+  it("includes reasoning and unions overlapping reasoning, text and plan intervals", () => {
+    const t = tracker();
+    t.itemStarted(reasoning, origin);
+    t.itemStarted(text, origin + 500);
+    t.itemStarted(plan, origin + 1000);
+    t.itemCompleted(reasoning, origin + 1500);
+    t.itemCompleted(text, origin + 2000);
+    t.itemCompleted(plan, origin + 3000);
+    expect(t.finalize(usage)).toEqual(expected(3000));
+  });
+
+  it("plan snapshots cannot turn the gap between updates into generation time", () => {
+    const t = tracker();
+    t.unmeasuredActivity();
+    t.unmeasuredActivity();
+    expect(t.finalize(usage)).toBeUndefined();
+    const covered = tracker();
+    covered.itemStarted(plan, origin);
+    covered.itemCompleted(plan, origin + 1000);
+    covered.unmeasuredActivity();
+    expect(covered.finalize(usage)).toEqual(expected(1000, 1, true));
+  });
+
+  it("excludes long tool, approval and user-input gaps between responses", () => {
+    const t = tracker();
+    t.itemStarted(reasoning, origin);
+    t.itemCompleted(reasoning, origin + 1000);
+    t.itemStarted(tool, origin + 1000);
+    t.wait(40_000);
+    t.wait(80_000);
+    t.itemCompleted(tool, origin + 100_000);
+    t.itemStarted(text, origin + 200_000);
+    t.itemCompleted(text, origin + 203_000);
+    expect(t.finalize(usage)).toEqual(expected(4000, 2));
+  });
+
+  it("cuts an unclosed response at tool start and never resumes on overlapping tool completions", () => {
+    const t = tracker();
+    t.itemStarted(text, origin);
+    t.activity(text.id, 500);
+    t.itemStarted(tool, origin + 1000);
+    t.itemStarted({ ...tool, id: "parallel" }, origin + 2000);
+    t.itemCompleted(tool, origin + 60_000);
+    t.itemCompleted({ ...tool, id: "parallel" }, origin + 100_000);
+    expect(t.finalize(usage)).toEqual(expected(1000, 1, true));
+  });
+
+  it("can observe model activity while background tools are still running", () => {
+    const t = tracker();
+    t.itemStarted(tool, origin);
+    t.itemStarted(text, origin + 1000);
+    t.itemCompleted(text, origin + 3000);
+    t.itemCompleted(tool, origin + 100_000);
+    expect(t.finalize(usage)).toEqual(expected(2000, 1, true));
+  });
+
+  it("background tool output and completion do not truncate observable concurrent generation", () => {
+    const t = tracker();
+    t.itemStarted(tool, origin);
+    t.itemStarted(reasoning, origin + 1000);
+    t.activity(reasoning.id, 1500);
+    t.toolOutput(tool.id);
+    t.itemCompleted(tool, origin + 2000);
+    t.activity(reasoning.id, 2500);
+    t.itemCompleted(reasoning, origin + 3000);
+    expect(t.finalize(usage)).toEqual(expected(2000, 1, true));
+  });
+
+  it("uses monotonic receipts when native timestamps are absent", () => {
+    const t = tracker();
+    t.itemStarted(reasoning, undefined, 1000);
+    t.activity(reasoning.id, 1500);
+    t.itemCompleted(reasoning, undefined, 2000);
+    expect(t.finalize(usage)).toEqual(expected(1000));
+  });
+
+  it("recovers missing starts from deltas as partial coverage", () => {
+    const t = tracker();
+    t.activity(text.id, 1000);
+    t.activity(text.id, 2000);
+    t.itemCompleted(text, undefined, 3000);
+    expect(t.finalize(usage)).toEqual(expected(2000, 1, true));
+  });
+
+  it("interruption or a missing completion retains only the last observed activity", () => {
+    const t = tracker();
+    t.itemStarted(reasoning, undefined, 1000);
+    t.activity(reasoning.id, 2000);
+    expect(t.finalize({ ...usage, usageStatus: "partial" })).toEqual(expected(1000, 1, true));
+  });
+
+  it("does not extend activity to delayed token usage or the turn terminal", () => {
+    const t = tracker();
+    t.itemStarted(text, origin);
+    t.itemCompleted(text, origin + 1000, 100_000);
+    t.itemStarted(tool, origin + 1000);
+    t.itemCompleted(tool, origin + 500_000);
+    expect(t.finalize(usage)).toEqual(expected(1000));
+  });
+
+  it("missing tool starts close at the last output observation, not tool output/completion", () => {
+    for (const complete of [false, true]) {
+      const t = tracker();
+      t.itemStarted(text, undefined, 1000);
+      t.activity(text.id, 2000);
+      if (complete) t.itemCompleted(tool, origin + 100_000);
+      else t.toolOutput();
+      expect(t.finalize(usage)).toEqual(expected(1000, 1, true));
+    }
+  });
+
+  it("omits old/no events, tools-only, snapshots-only and unmeasurable single deltas", () => {
+    for (const scenario of ["none", "tool", "snapshot", "delta", "zero", "reverse"] as const) {
+      const t = tracker();
+      if (scenario === "tool") {
+        t.itemStarted(tool, origin);
+        t.itemCompleted(tool, origin + 1000);
+      }
+      if (scenario === "snapshot") t.itemCompleted(text, origin + 1000);
+      if (scenario === "delta") t.activity(text.id, 1000);
+      if (scenario === "zero" || scenario === "reverse") {
+        t.itemStarted(text, origin + 1000);
+        t.itemCompleted(text, origin + (scenario === "zero" ? 1000 : 500));
+      }
+      expect(t.finalize(usage)).toBeUndefined();
+    }
+  });
+
+  it("marks a tools-only response or missing envelope partial while retaining measured windows", () => {
+    const t = tracker();
+    t.itemStarted(tool, origin);
+    t.itemCompleted(tool, origin + 1000);
+    t.itemCompleted(reasoning, origin + 2000);
+    t.itemStarted(text, origin + 3000);
+    t.itemCompleted(text, origin + 4000);
+    expect(t.finalize(usage)).toEqual(expected(1000, 1, true));
+  });
+
+  it("a fresh tracker after reconnect or a new turn cannot borrow previous intervals", () => {
+    const prior = tracker();
+    prior.itemStarted(text, origin);
+    prior.itemCompleted(text, origin + 1000);
+    expect(prior.finalize(usage)).toEqual(expected(1000));
+    prior.activity("late", 10_000);
+    expect(prior.finalize(usage)).toBeUndefined();
+    const resumed = tracker();
+    resumed.itemCompleted(text, origin + 20_000);
+    expect(resumed.finalize(usage)).toBeUndefined();
+    const suffix = tracker();
+    suffix.activity(text.id, 30_000);
+    suffix.itemCompleted(text, undefined, 31_000);
+    expect(suffix.finalize(usage)).toEqual(expected(1000, 1, true));
+  });
+
+  it("ignores duplicate completed items and asynchronous child relay messages", () => {
+    const t = tracker();
+    const child = { ...text, id: "relay", delivery: "async" } as const;
+    t.itemStarted(child, origin);
+    t.itemCompleted(child, origin + 100_000);
+    t.itemStarted(text, origin);
+    t.itemCompleted(text, origin + 1000);
+    t.itemStarted(text, origin + 100_000);
+    t.itemCompleted(text, origin + 200_000);
+    expect(t.finalize(usage)).toEqual(expected(1000));
+  });
+
+  it("omits a measured interval without valid provider turn usage", () => {
+    for (const outputTokens of [undefined, -1, NaN, Infinity, 1.5]) {
+      const t = tracker();
+      t.itemStarted(text, origin);
+      t.itemCompleted(text, origin + 1000);
+      expect(t.finalize({ ...usage, usageStatus: "partial", outputTokens })).toBeUndefined();
+    }
+  });
+});
diff --git a/apps/server/src/orchestration-v2/Adapters/CodexResponseThroughput.ts b/apps/server/src/orchestration-v2/Adapters/CodexResponseThroughput.ts
new file mode 100644
index 000000000..1df8c4443
--- /dev/null
+++ b/apps/server/src/orchestration-v2/Adapters/CodexResponseThroughput.ts
@@ -0,0 +1,150 @@
+import type { OrchestrationV2ProviderTurn, TurnTokenUsage } from "@t3tools/contracts";
+import type * as CodexSchema from "effect-codex-app-server/schema";
+
+type Item = CodexSchema.V2ItemStartedNotification["item"];
+type ResponseThroughput = NonNullable<OrchestrationV2ProviderTurn["responseThroughput"]>;
+
+/** Stock Codex has item boundaries, not model-response boundaries. Never time token usage. */
+export class CodexResponseThroughput {
+  private readonly active = new Map<string, { start: number; last: number }>();
+  private readonly completed = new Set<string>();
+  private readonly runningTools = new Set<string>();
+  private readonly unixOrigin: number;
+  private readonly monotonicOrigin: number;
+  private readonly intervals: Array<{ start: number; end: number }> = [];
+  private partial = false;
+  private finalized = false;
+  private outputSinceWait = false;
+
+  constructor(unixOrigin: number, monotonicOrigin = performance.now()) {
+    this.unixOrigin = unixOrigin;
+    this.monotonicOrigin = monotonicOrigin;
+  }
+
+  private at(nativeMs: number | undefined, receipt: number): number {
+    // A fixed mapping keeps wall-clock changes from moving receipt timestamps.
+    if (nativeMs !== undefined && Number.isFinite(nativeMs) && nativeMs > 0)
+      return nativeMs - this.unixOrigin + this.monotonicOrigin;
+    return receipt;
+  }
+
+  private record(start: number, end: number): void {
+    if (Number.isFinite(start) && Number.isFinite(end) && end > start)
+      this.intervals.push({ start, end });
+    else this.partial = true;
+  }
+
+  activity(itemId: string, receipt = performance.now()): void {
+    if (this.finalized || this.completed.has(itemId)) return;
+    if (!Number.isFinite(receipt)) {
+      this.partial = true;
+      return;
+    }
+    const active = this.active.get(itemId);
+    if (active === undefined) {
+      // A delta can recover a missing start, but only its observed suffix is timed.
+      this.partial = true;
+      this.active.set(itemId, { start: receipt, last: receipt });
+    } else active.last = Math.max(active.last, receipt);
+    this.outputSinceWait = true;
+  }
+
+  /** Plan snapshots have no output envelope; their spacing may include tool work. */
+  unmeasuredActivity(): void {
+    if (!this.finalized) this.partial = true;
+  }
+
+  itemStarted(item: Item, nativeMs?: number, receipt = performance.now()): void {
+    if (this.finalized) return;
+    if (item.type === "agentMessage" && item.delivery === "async") return;
+    if (item.type === "reasoning" || item.type === "agentMessage" || item.type === "plan") {
+      if (this.completed.has(item.id) || this.active.has(item.id)) return;
+      const at = this.at(nativeMs, receipt);
+      this.active.set(item.id, { start: at, last: at });
+      this.outputSinceWait = true;
+    } else if (
+      item.type !== "userMessage" &&
+      item.type !== "hookPrompt" &&
+      item.type !== "subAgentActivity"
+    ) {
+      // Tool execution, sleep, compaction and provider work cannot open a response window.
+      this.runningTools.add(item.id);
+      if (!this.outputSinceWait) this.partial = true;
+      this.wait(this.at(nativeMs, receipt));
+    }
+  }
+
+  itemCompleted(item: Item, nativeMs?: number, receipt = performance.now()): void {
+    if (this.finalized || this.completed.has(item.id)) return;
+    if (item.type === "agentMessage" && item.delivery === "async") return;
+    if (item.type !== "reasoning" && item.type !== "agentMessage" && item.type !== "plan") {
+      if (
+        item.type !== "userMessage" &&
+        item.type !== "hookPrompt" &&
+        item.type !== "subAgentActivity" &&
+        !this.runningTools.delete(item.id)
+      )
+        this.toolOutput();
+      return;
+    }
+    const active = this.active.get(item.id);
+    this.active.delete(item.id);
+    this.completed.add(item.id);
+    if (active === undefined) this.partial = true;
+    else this.record(active.start, this.at(nativeMs, receipt));
+  }
+
+  /** A wait closes windows; returning from it does not imply new model activity. */
+  wait(at = performance.now()): void {
+    if (this.finalized) return;
+    for (const active of this.active.values()) this.record(active.start, at);
+    if (this.active.size > 0) this.partial = true;
+    this.active.clear();
+    this.outputSinceWait = false;
+  }
+
+  /** Without a tool start, its output/completion cannot identify when generation stopped. */
+  toolOutput(itemId?: string): void {
+    if (this.finalized || (itemId !== undefined && this.runningTools.has(itemId))) return;
+    for (const active of this.active.values()) this.record(active.start, active.last);
+    if (this.active.size > 0) this.partial = true;
+    this.active.clear();
+    this.outputSinceWait = false;
+  }
+
+  finalize(usage: TurnTokenUsage): ResponseThroughput | undefined {
+    if (this.finalized) return undefined;
+    this.finalized = true;
+    // Missing completion/interruption: retain only the observed suffix, never the terminal wait.
+    for (const active of this.active.values()) this.record(active.start, active.last);
+    this.partial ||= this.active.size > 0;
+    this.active.clear();
+    this.runningTools.clear();
+    if (
+      usage.usageStatus === "unavailable" ||
+      usage.outputTokens === undefined ||
+      !Number.isSafeInteger(usage.outputTokens) ||
+      usage.outputTokens < 0
+    )
+      return undefined;
+
+    // Union output intervals, including reasoning/text that overlap. Tool durations are not summed
+    // or subtracted from whole-turn wall time; only observable response activity is timed.
+    const windows: Array<{ start: number; end: number }> = [];
+    for (const interval of this.intervals.toSorted((a, b) => a.start - b.start)) {
+      const previous = windows.at(-1);
+      if (previous !== undefined && interval.start <= previous.end)
+        previous.end = Math.max(previous.end, interval.end);
+      else windows.push({ ...interval });
+    }
+    const elapsedMs = windows.reduce((sum, window) => sum + window.end - window.start, 0);
+    if (!Number.isFinite(elapsedMs) || elapsedMs <= 0) return undefined;
+    return {
+      basis: "codex_active_windows_estimate",
+      outputTokens: usage.outputTokens,
+      elapsedMs,
+      responseCount: windows.length,
+      partial: this.partial || usage.usageStatus === "partial",
+    };
+  }
+}
