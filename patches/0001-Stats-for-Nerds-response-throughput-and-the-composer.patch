+          <PopoverTrigger
+            openOnHover
+            delay={150}
+            closeDelay={150}
+            render={
+              <button
+                type="button"
+                aria-label="Context usage details"
+                className="inline-flex items-center rounded-sm text-left outline-offset-2"
