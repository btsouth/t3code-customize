+                <p className="text-right text-muted-foreground tabular-nums">
+                  {formatResetsIn(window, now)}
+                </p>
+              )
+            )}
+          </div>
+        );
+      })}
+    </dl>
+  );
+}
+
+function UsageLimitsSummary({
+  limits,
+  providerName,
+}: {
+  limits: ServerProviderUsageLimits;
+  providerName: string;
+}) {
+  const [now, setNow] = useState(Date.now);
