+      )}
+      {stats.length > 0 && (
+        <span className="ms-auto inline-flex flex-wrap items-center gap-x-2.5">
+          {stats.map(({ key, node }, index) => (
+            <Fragment key={key}>
+              {index > 0 && (
+                <span aria-hidden="true" className="text-muted-foreground/40">
+                  ·
+                </span>
+              )}
+              {node}
+            </Fragment>
+          ))}
+        </span>
+      )}
+    </div>
+  );
+}
