+            </div>
+          </PopoverPopup>
+        </Popover>
+      ),
+    });
+  }
+
+  return (
+    <div
+      data-composer-stats="true"
+      aria-label="Stats for nerds"
+      className="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 pt-1.5 text-2xs leading-4 text-muted-foreground tabular-nums"
